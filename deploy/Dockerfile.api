# MANDELA — API image (build context: repo root)
# Runtime layout keeps the monorepo shape because config.ts derives
# BACKEND_ROOT (the SQL migrations folder) from __dirname.
FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY backend/apps/api/package.json backend/apps/api/
COPY backend/db ./backend/db
RUN pnpm install --frozen-lockfile --filter @mandela/api
COPY backend/apps/api backend/apps/api
RUN pnpm --filter @mandela/api build

FROM node:22-alpine
WORKDIR /app/backend/apps/api
ENV NODE_ENV=production
COPY --from=build /app/package.json /app/package.json
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/backend /app/backend
EXPOSE 4000
CMD ["node", "dist/main.js"]
