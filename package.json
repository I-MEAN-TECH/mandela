{
  "name": "mandela",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/check-theme-colors.mjs && turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "check:theme": "node scripts/check-theme-colors.mjs",
    "dev": "turbo run dev",
    "bootstrap:db": "pnpm --filter @mandela/api bootstrap:cluster",
    "provision:school": "pnpm --filter @mandela/api provision:school",
    "seed:demo": "pnpm --filter @mandela/api seed:demo",
    "seed:branding": "pnpm --filter @mandela/api seed:branding",
    "trace:logo": "node scripts/trace-logo.mjs frontend/mandela.png scripts/logo-traced.json",
    "compose:up": "docker compose -f backend/docker-compose.yml up -d",
    "compose:down": "docker compose -f backend/docker-compose.yml down"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/windows-x64",
      "@nestjs/core",
      "esbuild",
      "sharp"
    ]
  }
}
