{
  "name": "@mandela/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"process.env.NODE_OPTIONS=(process.env.NODE_OPTIONS||'')+' --max-old-space-size=3072';require('child_process').spawnSync('next',['dev','--turbopack','-p','3000'],{stdio:'inherit',shell:true,env:process.env})\"",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "check:budget": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@mandela/ui": "workspace:*",
    "lucide-react": "^1.47.0",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  }
}
